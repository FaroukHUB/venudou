# ============================================================
# VenuD'où — Variables d'environnement (frontend / Vite)
# Copier ce fichier vers .env et remplir les valeurs.
# AUCUNE vraie clé ne doit être commitée dans Git.
# ============================================================

# URL du projet Supabase (Dashboard Supabase → Settings → API)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique "anon" Supabase — publiable, protégée par RLS.
# NE JAMAIS mettre la clé service_role ici : elle n'a rien à faire
# dans le frontend ni dans aucune variable VITE_*.
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URL publique du site (utilisée pour les canoniques, sitemap, QR codes)
VITE_PUBLIC_BASE_URL=https://venudou.com
